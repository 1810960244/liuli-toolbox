# 运行数据（不入库）
server/toolbox.db
server/api.log
server/__pycache__/
*.pyc

# 后端不入库：api.py / setup.sh / test.sh 只存在于服务器 /opt/toolbox/server，
# 仓库仅保留前端与 Android 壳。改后端请在服务器上直接改并 restart toolbox
server/

# 构建产物
android/build/
android/out/

# 部署包快照
dist/

# 调研脚本（不入库）
tb_search.py
search.log

.DS_Store

# 签名密钥绝不入库：密钥曾连同口令一起躺在仓库和提交历史里，这行是防止再犯。
# CI 构建时从 GitHub Secret 还原成临时文件。
android/keystore.p12
*.p12
*.jks
*.keystore

# 明文文档：里面写过服务器 IP 与整套部署拓扑，只在服务器上留档
部署改动清单.md

# 凭据
.env
.env.local

# 构建产物（旧密钥签的包不进仓库，APK 走 Release 或由 CI 产出）
download/*.apk
